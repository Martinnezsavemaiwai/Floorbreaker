{
  "name": "floorbreaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -p . && vitest run && playwright test",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "package": "npm run build && tar -a -c -f floorbreaker-web.zip -C dist ."
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "beepbox": "^4.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
